<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>
      <%= resume.personal.firstName %> <%= resume.personal.lastName %> - <%=
      resume.personal.title %>
    </title>
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Cambo&display=swap");

      body {
        display: flex;
        justify-content: center;
        width: 100%;
        font-size: 13pt;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: Cambo, Arial, sans-serif;
        font-size: 12pt;
      }

      a {
        color: #333;
      }

      li {
        list-style-position: inside;
        margin-bottom: 5px;
      }

      .resume-container {
        max-width: 210mm;
        width: 100%;
        padding: 10mm;
        page-break-inside: avoid;
      }

      .bold {
        font-weight: bold;
      }

      section {
        margin-bottom: 20px;
        page-break-inside: avoid;
      }

      .profile-container {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 8pt;
      }

      .profile-name {
        font-size: 30pt;
        font-weight: bold;
        color: rgb(3, 76, 158);
      }

      .social-link-container {
        border-top: 2pt solid #034c9e;
        border-bottom: 2pt solid #034c9e;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-evenly;
        padding: 10pt;
        gap: 4pt;
        align-items: center;
      }

      .summary {
        line-height: 16pt;
        text-align: justify;
        font-style: italic;
      }

      .section-header {
        display: flex;
        flex-direction: column;
        gap: 10px;
      }

      .section-title {
        color: #034c9e;
        font-weight: 700;
      }

      .ruler {
        height: 3px;
        width: 100%;
        background-color: #034c9e;
      }

      .experience-header,
      .education-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin: 10px 0;
      }

      .skill-container {
        margin: 8px 0;
      }

      .company {
        font-weight: 700;
      }

      .title {
        font-style: italic;
      }

      .location {
        font-weight: 700;
      }

      .duties {
        margin-left: 30px;
      }
    </style>
  </head>

  <body>
    <div class="resume-container">
      <!-- Header -->
      <section class="header">
        <div class="profile-container">
          <h2 class="profile-name">
            <%= resume.personal.firstName %> <%= resume.personal.lastName %>
          </h2>
          <p><%= resume.personal.title %></p>
        </div>
      </section>
      <section>
        <div class="social-link-container">
          <p><%= resume.personal.phone %></p>
          <p><%= resume.personal.email %></p>
          <p>
            <%= resume.personal.city %>, <%= resume.personal.state %>, <%=
            resume.personal.country %>
          </p>
          <p><%= resume.personal.postalCode %></p>
        </div>
      </section>

      <!-- Summary -->
      <section>
        <p class="summary"><%= resume.personal.summary %></p>
      </section>

      <!-- Experience -->
      <section id="experience">
        <div class="section-header">
          <h2 class="section-title">PROFESSIONAL EXPERIENCE</h2>
          <div class="ruler"></div>
        </div>

        <% resume.experience.forEach(exp=> { %>
        <div class="experience-container">
          <div class="experience-header">
            <div>
              <h3 class="company"><%= exp.company %></h3>
              <p class="title"><%= exp.position %></p>
            </div>
            <div style="text-align: right">
              <p class="location">
                <%= exp.city %>, <%= exp.province %>, <%= exp.country %>
              </p>
              <p class="title">
                <%= exp.startMonth %> <%= exp.startYear %> - <%=
                exp.isCurrentlyWorking ? 'Present' : exp.endMonth + ' ' +
                exp.endYear %>
              </p>
            </div>
          </div>
          <div class="duties">
            <ul>
              <% exp.responsibilities.forEach(item=> { %>
              <li><%= item %></li>
              <% }) %>
            </ul>
          </div>
        </div>
        <% }) %>
      </section>

      <!-- Education -->
      <section id="education">
        <div class="section-header">
          <h2 class="section-title">EDUCATION</h2>
          <div class="ruler"></div>
        </div>

        <% resume.education.forEach(edu=> { %>
        <div class="education-container">
          <div>
            <h3 class="company">
              <%= edu.degree %> in <%= edu.fieldOfStudy %>
            </h3>
            <p>
              <%= edu.school %>, <span class="bold"> <%= edu.location %> </span>
            </p>
          </div>
          <% if (!edu.removeGraduationDate) { %>
          <p style="text-align: right" class="title">
            <%= edu.graduationMonth %> <%= edu.graduationYear %>
          </p>
          <% } %>
        </div>
        <% }) %>
      </section>

      <!-- Skills -->
      <section id="skills">
        <div class="section-header">
          <h2 class="section-title">SKILLS</h2>
          <div class="ruler"></div>
        </div>
        <div class="skill-container">
          <ul>
            <% resume.skills.forEach(skill=> { %>
            <li><%= skill %></li>
            <% }) %>
          </ul>
        </div>
      </section>

      <!-- Certifications -->
      <section id="certification">
        <div class="section-header">
          <h2 class="section-title">CERTIFICATIONS</h2>
          <div class="ruler"></div>
        </div>
        <div class="skill-container">
          <ul>
            <% resume.certifications.forEach(cert=> { %>
            <li><%= cert %></li>
            <% }) %>
          </ul>
        </div>
      </section>

      <!-- References -->
      <section id="references">
        <div class="section-header">
          <h2 class="section-title">REFERENCES</h2>
          <div class="ruler"></div>
        </div>
        <div class="skill-container">
          <% if (resume.references && resume.references.length> 0) { %> <%
          resume.references.forEach(ref=> { %>
          <li>
            <%= ref.firstName %> <%= ref.lastName %> - <%= ref.jobTitle %>, <%=
            ref.company %>. Email: <%= ref.email %>, Phone: <%= ref.phone %>
            (<%= ref.relationshipStatus %>)
          </li>
          <% }) %> <% } else { %>
          <li>Available upon request</li>
          <% } %>
        </div>
      </section>
    </div>
  </body>
</html>
