<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{resume.personal.firstName}} {{resume.personal.lastName}} - Resume</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Amaranth:wght@400;700&display=swap');

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Amaranth', sans-serif;
      background: #f8f9f9;
      color: #333;
      padding: 20px;
    }

    .resume-container {
        max-width: 210mm;
        margin: 0 auto;
        background: white;
    }

    header {
      text-align: center;
      border-bottom: 3px solid #3a7258;
      margin-bottom: 15px;
      padding-bottom: 8px;
    }

    header h1 {
      font-size: 1.9rem;
      color: #1a3c2f;
    }

    header h2 {
      font-size: 1.05rem;
      color: #3a7258;
      margin-top: 4px;
    }

    .contact {
      text-align: center;
      font-size: 0.9rem;
      color: #444;
      margin: 10px 0 20px;
      line-height: 1.4;
    }

    .contact a {
      color: #3a7258;
      text-decoration: none;
    }

    section{
      margin-bottom: 30px;
    }

    section h3 {
      color: #3a7258;
      border-bottom: 2px solid #3a7258;
      padding-bottom: 3px;
      margin-bottom: 6px;
      font-size: 1rem;
      text-transform: uppercase;
    }

    .summary p, .education p, .certifications ul, .references p {
      font-size: 0.9rem;
      line-height: 1.4;
      margin-bottom: 6px;
    }

    .skill-tags {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }

    .skill-tags li {
      background: #e6f0ea;
      color: #1a3c2f;
      border-radius: 4px;
      padding: 4px 8px;
      font-size: 0.85rem;
      border: 1px solid #3a7258;
    }

    .exp-item {
      margin-bottom: 12px;
    }

    .exp-item h4 {
      font-size: 1rem;
      color: #1a3c2f;
      font-weight: 600;
    }

    .exp-item p {
      font-size: 0.9rem;
      color: #555;
    }

    .exp-item ul {
      margin-left: 18px;
      margin-top: 4px;
      font-size: 0.85rem;
      line-height: 1.4;
    }

    .certifications ul {
      margin-left: 18px;
      font-size: 0.9rem;
    }

    .references {
      margin-top: 10px;
    }

  </style>
</head>

<body>
  <div class="resume-container">
    <!-- Header -->
    <header>
      <h1>{{resume.personal.firstName}} {{resume.personal.lastName}}</h1>
      <h2>{{resume.personal.title}}</h2>
    </header>

    <!-- Contact Info -->
    <section class="contact">
      <p>{{resume.personal.phone}}</p>
      <p>{{resume.personal.city}}, {{resume.personal.state}} {{resume.personal.postalCode}}</p>
      <p>{{resume.personal.country}}</p>
      <p><a href="mailto:{{resume.personal.email}}">{{resume.personal.email}}</a></p>
    </section>

    <!-- Summary -->
    <section class="summary">
      <h3>Professional Summary</h3>
      <p>{{resume.personal.summary}}</p>
    </section>

    <!-- Education -->
    <section class="education">
      <h3>Education</h3>
      {{#each resume.education}}
      <div class="edu-item">
        <h4>{{degree}} in {{fieldOfStudy}}</h4>
        <p>{{school}} — {{location}}</p>
        {{#unless removeGraduationDate}}
          <p>{{graduationMonth}} {{graduationYear}}</p>
        {{/unless}}
      </div>
      {{/each}}
    </section>

    <!-- Skills -->
    {{#if resume.skills}}
    <section class="skills">
      <h3>Key Skills</h3>
      <ul class="skill-tags">
        {{#each resume.skills}}
          <li>{{this}}</li>
        {{/each}}
      </ul>
    </section>
    {{/if}}

    <!-- Certifications -->
    {{#if resume.certifications}}
    <section class="certifications">
      <h3>Certifications</h3>
      <ul>
        {{#each resume.certifications}}
          <li>{{this}}</li>
        {{/each}}
      </ul>
    </section>
    {{/if}}

    <!-- Experience -->
    <section class="experience">
      <h3>Professional Experience</h3>
      {{#each resume.experience}}
      <div class="exp-item">
        <h4>{{position}}</h4>
        <p><strong>{{company}}</strong> — {{city}}, {{province}}, {{country}}</p>
        <p>{{startMonth}} {{startYear}} – {{#if isCurrentlyWorking}}Present{{else}}{{endMonth}} {{endYear}}{{/if}}</p>
        <ul>
          {{#each responsibilities}}
          <li>{{this}}</li>
          {{/each}}
        </ul>
      </div>
      {{/each}}
    </section>

    <!-- References -->
    <section class="references">
      <h3>References</h3>
      {{#if resume.references.length}}
        {{#each resume.references}}
          <p><strong>{{firstName}} {{lastName}}</strong> — {{jobTitle}}, {{company}}</p>
          {{#if email}}
            <p>Email: {{email}}</p>
          {{/if}}
          {{#if phone}}
            <p>Phone: {{phone}}</p>
          {{/if}}

          {{#if relationshipStatus}}
            <p>Relationship: {{relationshipStatus}}</p>
          {{/if}}
        {{/each}}
      {{else}}
        <p>Available upon request.</p>
      {{/if}}
    </section>
  </div>
</body>
</html>
