<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{#if resume.personal}}{{resume.personal.firstName}} {{resume.personal.lastName}}{{else}}Resume{{/if}}</title>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Fjalla+One&display=swap');
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Fjalla One', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #f5f5f5;
    }
    a { font-size: 13px; color: #555; }
    .resume { max-width: 210mm; min-height: 297mm; margin: 0 auto; background: white; }
    .header { color: white; padding: 50px 60px; text-align: center; }
    .header h1 { font-size: 42px; font-weight: 300; letter-spacing: 2px; text-transform: uppercase; color: black; }
    .header .job-title { font-size: 16px; font-weight: 400; letter-spacing: 3px; text-transform: uppercase; }
    .content { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; padding: 50px 60px; }
    .section { margin-bottom: 35px; }
    .section-title {
      color: #c85a54; font-size: 14px; font-weight: 600; letter-spacing: 1.5px;
      text-transform: uppercase; margin-bottom: 20px; padding-bottom: 8px;
      border-bottom: 2px solid #c85a54;
    }
    .job, .education-item, .cert-item { margin-bottom: 25px; }
    .job-title { font-weight: 600; font-size: 15px; color: #333; margin-bottom: 3px; }
    .job-details { font-size: 13px; color: #666; margin-bottom: 10px; }
    ul { margin-left: 20px; margin-top: 8px; }
    li { font-size: 13px; line-height: 1.6; color: #555; margin-bottom: 8px; }
    .summary-text { font-size: 14px; line-height: 1.7; color: #555; text-align: justify; }
    .skills-list { list-style: none; margin-left: 0; }
    .skills-list li { padding-left: 20px; position: relative; margin-bottom: 10px; }
    .skills-list li:before { content: "•"; color: #c85a54; font-weight: bold; position: absolute; left: 0; }
    .avatar { width: 120px; height: 120px; border-radius: 8px; object-fit: cover; margin: 0 auto 12px auto; }
    .contact-item { font-size: 13px; color: #444; margin-bottom: 8px; }
    .reference-item { margin-bottom: 12px; font-size: 13px; color: #444; }
  </style>
</head>

<body>
  <div class="resume">
    <!-- Header -->
    <div class="header">
      <h1>
        {{#if resume.personal}}
          {{resume.personal.firstName}} {{resume.personal.lastName}}
        {{else}}
          Candidate Name
        {{/if}}
      </h1>

      {{#if resume.personal.title}}
        <div class="job-title">{{resume.personal.title}}</div>
      {{/if}}
    </div>

    <!-- Main Content -->
    <div class="content">
      <!-- LEFT COLUMN -->
      <div class="left-column">

        <!-- Summary -->
        {{#if resume.personal.summary}}
        <div class="section">
          <h2 class="section-title">Summary</h2>
          <p class="summary-text">{{resume.personal.summary}}</p>
        </div>
        {{/if}}

        <!-- Education -->
        {{#if resume.education}}
        {{#if resume.education.length}}
        <div class="section">
          <h2 class="section-title">Education</h2>
          {{#each resume.education}}
          <div class="education-item">
            <div class="degree">{{#if degree}}{{degree}}{{else}}Education{{/if}}{{#if fieldOfStudy}} in {{fieldOfStudy}}{{/if}}</div>
            <div class="school">{{#if school}}{{school}}{{/if}}{{#if location}} - {{location}}{{/if}}</div>
            {{#unless removeGraduationDate}}
              <div class="date">
                {{#if graduationMonth}}{{graduationMonth}} {{/if}}{{#if graduationYear}}{{graduationYear}}{{/if}}
              </div>
            {{/unless}}
          </div>
          {{/each}}
        </div>
        {{/if}}
        {{/if}}

        <!-- Experience -->
        {{#if resume.experience}}
        {{#if resume.experience.length}}
        <div class="section">
          <h2 class="section-title">Work Experience</h2>
          {{#each resume.experience}}
          <div class="job">
            <div class="job-header">
              <div class="job-title">{{#if position}}{{position}}{{else}}Role{{/if}}</div>
              <div class="job-details">
                <span class="date">
                  {{#if startMonth}}{{startMonth}} {{/if}}{{#if startYear}}{{startYear}}{{/if}}
                  {{#if isCurrentlyWorking}}
                    — Present
                  {{else}}
                    {{#if endMonth}} — {{endMonth}}{{/if}} {{#if endYear}}{{endYear}}{{/if}}
                  {{/if}}
                </span>
                {{#if company}} | <span class="company">{{company}}</span>{{/if}}
                <span class="location">
                  {{#if city}} , {{city}}{{/if}}{{#if province}} , {{province}}{{/if}}{{#if country}} , {{country}}{{/if}}
                </span>
              </div>
            </div>

            {{#if responsibilities}}
              {{#if responsibilities.length}}
              <ul>
                {{#each responsibilities}}
                <li>{{this}}</li>
                {{/each}}
              </ul>
              {{/if}}
            {{/if}}
          </div>
          {{/each}}
        </div>
        {{/if}}
        {{/if}}

      </div>

      <!-- RIGHT COLUMN -->
      <div class="right-column">

        <!-- Contact -->
        <div class="section">
          <h2 class="section-title">Contact</h2>
          {{#if resume.personal.phone}}<div class="contact-item">{{resume.personal.phone}}</div>{{/if}}
          {{#if resume.personal.email}}<div class="contact-item"><a href="mailto:{{resume.personal.email}}">{{resume.personal.email}}</a></div>{{/if}}
          {{#if resume.personal.city}}
            <div class="contact-item">
              {{resume.personal.city}}{{#if resume.personal.state}}, {{resume.personal.state}}{{/if}}{{#if resume.personal.country}} , {{resume.personal.country}}{{/if}}
            </div>
          {{/if}}
          {{#if resume.personal.linkedin}}<div class="contact-item"><a href="{{resume.personal.linkedin}}" target="_blank">LinkedIn</a></div>{{/if}}
          {{#if resume.personal.website}}<div class="contact-item"><a href="{{resume.personal.website}}" target="_blank">{{resume.personal.website}}</a></div>{{/if}}
        </div>

        <!-- Skills -->
        {{#if resume.skills}}
        {{#if resume.skills.length}}
        <div class="section">
          <h2 class="section-title">Skills</h2>
          <ul class="skills-list">
            {{#each resume.skills}}
            <li>{{this}}</li>
            {{/each}}
          </ul>
        </div>
        {{/if}}
        {{/if}}

        <!-- Certifications -->
        {{#if resume.certifications}}
        {{#if resume.certifications.length}}
        <div class="section">
          <h2 class="section-title">Certifications</h2>
          {{#each resume.certifications}}
          <div class="cert-item">{{this}}</div>
          {{/each}}
        </div>
        {{/if}}
        {{/if}}

        <div class="section">
          <h2 class="section-title">References</h2>
          {{#if resume.references}}
            {{#if resume.references.length}}
              {{#each resume.references}}
                <div class="reference-item">
                  <div class="reference-name">{{firstName}} {{lastName}}</div>
                  <div class="reference-title">{{jobTitle}}{{#if company}}, {{company}}{{/if}}</div>
                  {{#if email}}<div class="reference-contact">Email: <a href="mailto:{{email}}">{{email}}</a></div>{{/if}}
                  {{#if phone}}<div class="reference-contact">Phone: {{phone}}</div>{{/if}}
                  {{#if relationshipStatus}}<div class="reference-contact">{{relationshipStatus}}</div>{{/if}}
                </div>
              {{/each}}
            {{else}}
              <p>Available upon request.</p>
            {{/if}}
          {{else}}
            <p>Available upon request.</p>
          {{/if}}

        </div>

      </div>
    </div>
  </div>
</body>
</html>
