<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Professional Resume</title>
    <style>


        @import url('https://fonts.googleapis.com/css2?family=Fjalla+One&display=swap');

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        a{
            font-size: 13px;
            color: #555;
        }
        body {
            font-family: 'Fjalla One', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f5f5f5;
            padding: 40px 20px;
        }

        .resume {
            max-width: 850px;
            margin: 0 auto;
            background: white;
        }

        .header {
           
            color: white;
            padding: 50px 60px;
            text-align: center;
        }

        .header h1 {
            font-size: 42px;
            font-weight: 300;
            letter-spacing: 2px;
            margin-bottom: 10px;
            text-transform: uppercase;
        }

        .header .job-title {
            font-size: 16px;
            font-weight: 400;
            letter-spacing: 3px;
            text-transform: uppercase;
        }

        .content {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
            padding: 50px 60px;
        }

        .left-column {
            grid-column: 1;
        }

        .right-column {
            grid-column: 2;
        }

        .section {
            margin-bottom: 35px;
        }

        .section-title {
            color: #c85a54;
            font-size: 14px;
            font-weight: 600;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            margin-bottom: 20px;
            padding-bottom: 8px;
            border-bottom: 2px solid #c85a54;
        }

        .job, .education-item, .cert-item {
            margin-bottom: 25px;
        }

        .job-header {
            margin-bottom: 10px;
        }

        .job-title {
            font-weight: 600;
            font-size: 15px;
            color: #333;
            margin-bottom: 3px;
        }

        .job-details {
            font-size: 13px;
            color: #666;
            margin-bottom: 10px;
        }

        .job-details .company {
            font-weight: 500;
        }

        .job-details .location {
            font-style: italic;
        }

        ul {
            margin-left: 20px;
            margin-top: 8px;
        }

        li {
            font-size: 13px;
            line-height: 1.6;
            color: #555;
            margin-bottom: 8px;
        }

        .contact-item {
            display: flex;
            align-items: center;
            margin-bottom: 12px;
            font-size: 13px;
            color: #555;
        }

        .contact-icon {
            width: 16px;
            height: 16px;
            margin-right: 12px;
            color: #c85a54;
        }

        .summary-text {
            font-size: 14px;
            line-height: 1.7;
            color: #555;
            text-align: justify;
        }

        .skills-list {
            list-style: none;
            margin-left: 0;
        }

        .skills-list li {
            padding-left: 20px;
            position: relative;
            margin-bottom: 10px;
        }

        .skills-list li:before {
            content: "•";
            color: #c85a54;
            font-weight: bold;
            position: absolute;
            left: 0;
        }

        .degree {
            font-weight: 600;
            font-size: 14px;
            color: #333;
            margin-bottom: 3px;
        }

        .school {
            font-size: 13px;
            color: #666;
            margin-bottom: 3px;
        }

        .date {
            font-size: 12px;
            color: #999;
        }

        .reference-item {
            margin-bottom: 20px;
        }

        .reference-name {
            font-weight: 600;
            font-size: 14px;
            color: #333;
        }

        .reference-title {
            font-size: 13px;
            color: #666;
            font-style: italic;
        }

        .reference-contact {
            font-size: 12px;
            color: #555;
            margin-top: 5px;
        }
    </style>
</head>
<body>
    <div class="resume">
        <!-- Header -->
        <div class="header">
            <h1>Your Name</h1>
            <div class="job-title">Your Job Title</div>
        </div>

        <!-- Main Content -->
        <div class="content">
            <!-- Left Column -->
            <div class="left-column">
                <!-- Summary -->
                <div class="section">
                    <h2 class="section-title">Summary</h2>
                    <p class="summary-text">
                        Professional with X+ years of experience in [your field]. Demonstrated expertise in [key skill areas]. Proven track record of [achievement]. Looking to leverage skills and experience to [career goal].
                    </p>
                </div>

                <!-- Education -->
                <div class="section">
                    <h2 class="section-title">Education</h2>
                    <div class="education-item">
                        <div class="degree">Bachelor of Science in Computer Science</div>
                        <div class="school">University Name, City, State</div>
                        <div class="date">May 2020</div>
                    </div>
                    <div class="education-item">
                        <div class="degree">Associate Degree in Information Technology</div>
                        <div class="school">College Name, City, State</div>
                        <div class="date">May 2018</div>
                    </div>
                </div>

                <!-- Work Experience -->
                <div class="section">
                    <h2 class="section-title">Work Experience</h2>
                    
                    <div class="job">
                        <div class="job-header">
                            <div class="job-title">Job Title</div>
                            <div class="job-details">
                                <span class="date">Jan 2021 - Present</span> | <span class="company">Company Name</span>, <span class="location">City, State</span>
                            </div>
                        </div>
                        <ul>
                            <li>Achievement or responsibility demonstrating impact and results</li>
                            <li>Key project or initiative you led with measurable outcomes</li>
                            <li>Process improvement or innovation you implemented</li>
                            <li>Cross-functional collaboration or leadership example</li>
                        </ul>
                    </div>

                    <div class="job">
                        <div class="job-header">
                            <div class="job-title">Previous Job Title</div>
                            <div class="job-details">
                                <span class="date">June 2019 - Dec 2020</span> | <span class="company">Company Name</span>, <span class="location">City, State</span>
                            </div>
                        </div>
                        <ul>
                            <li>Major accomplishment with quantifiable results</li>
                            <li>Responsibility showcasing relevant skills</li>
                            <li>Challenge overcome or problem solved</li>
                        </ul>
                    </div>

                    <div class="job">
                        <div class="job-header">
                            <div class="job-title">Earlier Position</div>
                            <div class="job-details">
                                <span class="date">Jan 2018 - May 2019</span> | <span class="company">Company Name</span>, <span class="location">City, State</span>
                            </div>
                        </div>
                        <ul>
                            <li>Key responsibility or achievement</li>
                            <li>Skill development or training completed</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Right Column -->
            <div class="right-column">
                <!-- Contact -->
                <div class="section">
                    <h2 class="section-title">Contact</h2>
                    <div class="contact-item">
                        <span class="contact-icon">📞</span>
                        <span>(123) 456-7890</span>
                    </div>
                    <div class="contact-item">
                        <span class="contact-icon">✉️</span>
                        <a href="mailto:email@example.com">your.email@example.com</a>
                    </div>
                    <div class="contact-item">
                        <span class="contact-icon">📍</span>
                        <span>123 Main Street<br>City, State 12345</span>
                    </div>
                    <div class="contact-item">
                        <span class="contact-icon">💼</span>
                        <a href="https://linked.com/in/username">linkedin.com/in/yourprofile</a>
                    </div>
                    <div class="contact-item">
                        <span class="contact-icon">💼</span>
                        <a href="https://godstimeweb.vercel.app">https://godstimeweb.vercel.app</a>
                    </div>
                </div>

                <!-- Skills -->
                <div class="section">
                    <h2 class="section-title">Skills</h2>
                    <ul class="skills-list">
                        <li>Skill Category 1</li>
                        <li>Skill Category 2</li>
                        <li>Skill Category 3</li>
                        <li>Skill Category 4</li>
                        <li>Skill Category 5</li>
                        <li>Skill Category 6</li>
                    </ul>
                </div>

                <!-- Certifications -->
                <div class="section">
                    <h2 class="section-title">Certifications</h2>
                    <div class="cert-item">
                        <div class="degree">Professional Certification Name</div>
                        <div class="school">Issuing Organization</div>
                        <div class="date">Issued: January 2023</div>
                    </div>
                    <div class="cert-item">
                        <div class="degree">Another Certification</div>
                        <div class="school">Issuing Organization</div>
                        <div class="date">Issued: June 2022</div>
                    </div>
                    <div class="cert-item">
                        <div class="degree">Additional Certification</div>
                        <div class="school">Issuing Organization</div>
                        <div class="date">Issued: March 2021</div>
                    </div>
                </div>

                <!-- Language -->
                <div class="section">
                    <h2 class="section-title">Language</h2>
                    <div class="reference-item">
                        <div class="reference-name">French</div>                    
                    </div>
                    <div class="reference-item">
                        <div class="reference-name">English</div>                    
                    </div>
                    
                </div>

                <!-- References -->
                <div class="section">
                    <h2 class="section-title">References</h2>
                    <div class="reference-item">
                        <div class="reference-name">Reference Name</div>
                        <div class="reference-title">Job Title, Company</div>
                        <div class="reference-contact">Email: reference@email.com</div>
                        <div class="reference-contact">Phone: (123) 456-7890</div>
                        <div class="reference-contact">Brother</div>
                    </div>
                    <div class="reference-item">
                        <div class="reference-name">Reference Name</div>
                        <div class="reference-title">Job Title, Company</div>
                        <div class="reference-contact">Email: reference@email.com</div>
                        <div class="reference-contact">Phone: (123) 456-7890</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>