<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{#if resume.personal}}{{resume.personal.firstName}} {{resume.personal.lastName}}{{else}}Resume{{/if}}</title>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Fjalla+One&display=swap');
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Fjalla One', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #f5f5f5;
    }

    a { font-size: 13px; color: #555; text-decoration: underline; }

    .resume {
      max-width: 210mm;
      margin: 0 auto;
      background: white;
    }

    /* HEADER */
    .header {
      text-align: center;
      padding: 30px 40px 30px;
      color: #000;
      border-bottom: 3px solid #c85a54;
    }

    .header h1 {
      font-size: 35px;
      font-weight: 600;
      letter-spacing: 2px;
      text-transform: uppercase;
      margin-bottom: 10px;
    }

    .header .job-title {
      font-size: 15px;
      letter-spacing: 2px;
      color: #555;
      text-transform: uppercase;
    }

    /* CONTENT */
    .content {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 40px;
      padding: 40px 60px;
    }

    .section {
      margin-bottom: 25px;
    }

    .section-title {
      color: #c85a54;
      font-size: 14px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      margin-bottom: 15px;
      padding-bottom: 6px;
      border-bottom: 2px solid #c85a54;
    }

    /* SHARED STYLES for Education, Jobs, Certifications */
    .entry {
      margin-bottom: 14px;
      font-size: 13px;
      color: #000;
    }

    .entry-title {
      font-weight: 600;
      font-size: 15px;
      color: #000;
      margin-bottom: 3px;
    }

    .entry-subtitle {
      color: #555;
      font-size: 13px;
      margin-bottom: 4px;
    }

    .entry-date {
      font-size: 12px;
      color: #777;
      margin-bottom: 8px;
    }

    .entry ul {
      margin-left: 20px;
      margin-top: 5px;
    }

    .entry li {
      font-size: 13px;
      line-height: 1.6;
      color: #555;
      margin-bottom: 5px;
    }

    .summary-text {
      font-size: 14px;
      line-height: 1.7;
      color: #555;
      text-align: justify;
    }

    .skills-list {
      margin-left: 0;
    }

    .skills-list li {
      position: relative;
      margin-bottom: 10px;
      list-style-position: inside;
    }

    .contact-item, .reference-item {
      font-size: 13px;
      color: #444;
      margin-bottom: 8px;
    }

    .reference-item .reference-name {
      font-weight: 600;
      margin-bottom: 3px;
    }

  </style>
</head>

<body>
  <div class="resume">
    <!-- Header -->
    <div class="header">
      <h1>
        {{#if resume.personal}}
          {{resume.personal.firstName}} {{resume.personal.lastName}}
        {{else}}
          Candidate Name
        {{/if}}
      </h1>

      {{#if resume.personal.title}}
        <div class="job-title">{{resume.personal.title}}</div>
      {{/if}}
    </div>

    <!-- Main Content -->
    <div class="content">
      <!-- LEFT COLUMN -->
      <div class="left-column">

        <!-- Summary -->
        {{#if resume.personal.summary}}
        <div class="section">
          <h2 class="section-title">Summary</h2>
          <p class="summary-text">{{resume.personal.summary}}</p>
        </div>
        {{/if}}

        <!-- Education -->
        {{#if resume.education}}
        {{#if resume.education.length}}
        <div class="section">
          <h2 class="section-title">Education</h2>
          {{#each resume.education}}
          <div class="entry">
            <div class="entry-title">{{#if degree}}{{degree}}{{else}}Education{{/if}}{{#if fieldOfStudy}} in {{fieldOfStudy}}{{/if}}</div>
            <div class="entry-subtitle">{{#if school}}{{school}}{{/if}}{{#if location}} - {{location}}{{/if}}</div>
            {{#unless removeGraduationDate}}
              <div class="entry-date">
                {{#if graduationMonth}}{{graduationMonth}} {{/if}}{{#if graduationYear}}{{graduationYear}}{{/if}}
              </div>
            {{/unless}}
          </div>
          {{/each}}
        </div>
        {{/if}}
        {{/if}}

        <!-- Experience -->
        {{#if resume.experience}}
        {{#if resume.experience.length}}
        <div class="section">
          <h2 class="section-title">Work Experience</h2>
          {{#each resume.experience}}
          <div class="entry">
            <div class="entry-title">{{#if position}}{{position}}{{else}}Role{{/if}}</div>
            <div class="entry-subtitle">
              {{#if company}}{{company}}{{/if}}
              {{#if city}}, {{city}}{{/if}}{{#if province}}, {{province}}{{/if}}{{#if country}}, {{country}}{{/if}}
            </div>
            <div class="entry-date">
              {{#if startMonth}}{{startMonth}} {{/if}}{{#if startYear}}{{startYear}}{{/if}}
              {{#if isCurrentlyWorking}}
                — Present
              {{else}}
                {{#if endMonth}} — {{endMonth}}{{/if}} {{#if endYear}}{{endYear}}{{/if}}
              {{/if}}
            </div>
            {{#if responsibilities}}
              {{#if responsibilities.length}}
              <ul>
                {{#each responsibilities}}
                <li>{{this}}</li>
                {{/each}}
              </ul>
              {{/if}}
            {{/if}}
          </div>
          {{/each}}
        </div>
        {{/if}}
        {{/if}}

      </div>

      <!-- RIGHT COLUMN -->
      <div class="right-column">

        <!-- Contact -->
        <div class="section">
          <h2 class="section-title">Contact</h2>
          {{#if resume.personal.phone}}<div class="contact-item">{{resume.personal.phone}}</div>{{/if}}
          {{#if resume.personal.email}}<div class="contact-item"><a href="mailto:{{resume.personal.email}}">{{resume.personal.email}}</a></div>{{/if}}
          {{#if resume.personal.city}}
            <div class="contact-item">
              {{resume.personal.city}}{{#if resume.personal.state}}, {{resume.personal.state}}{{/if}}{{#if resume.personal.country}} , {{resume.personal.country}}{{/if}}
            </div>
          {{/if}}
          {{#if resume.personal.linkedin}}<div class="contact-item"><a href="{{resume.personal.linkedin}}" target="_blank">LinkedIn</a></div>{{/if}}
          {{#if resume.personal.website}}<div class="contact-item"><a href="{{resume.personal.website}}" target="_blank">{{resume.personal.website}}</a></div>{{/if}}
        </div>

        <!-- Skills -->
        {{#if resume.skills}}
        {{#if resume.skills.length}}
        <div class="section">
          <h2 class="section-title">Skills</h2>
          <ul class="skills-list">
            {{#each resume.skills}}
            <li>{{this}}</li>
            {{/each}}
          </ul>
        </div>
        {{/if}}
        {{/if}}

        <!-- Certifications -->
        {{#if resume.certifications}}
        {{#if resume.certifications.length}}
        <div class="section">
          <h2 class="section-title">Certifications</h2>
          {{#each resume.certifications}}
          <div class="entry">{{this}}</div>
          {{/each}}
        </div>
        {{/if}}
        {{/if}}

        <!-- References -->
        <div class="section">
          <h2 class="section-title">References</h2>
          {{#if resume.references}}
            {{#if resume.references.length}}
              {{#each resume.references}}
                <div class="reference-item">
                  <div class="reference-name">{{firstName}} {{lastName}}</div>
                  <div class="reference-title">{{jobTitle}}{{#if company}}, {{company}}{{/if}}</div>
                  {{#if email}}<div class="reference-contact">Email: <a href="mailto:{{email}}">{{email}}</a></div>{{/if}}
                  {{#if phone}}<div class="reference-contact">Phone: {{phone}}</div>{{/if}}
                  {{#if relationshipStatus}}<div class="reference-contact">{{relationshipStatus}}</div>{{/if}}
                </div>
              {{/each}}
            {{else}}
              <p>Available upon request.</p>
            {{/if}}
          {{else}}
            <p>Available upon request.</p>
          {{/if}}
        </div>
      </div>
    </div>
  </div>
</body>
</html>
