<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{personal.firstName}} {{personal.lastName}} - Resume</title>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Fjalla+One&display=swap');
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Fjalla One', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #f5f5f5;
    }
    a { font-size: 13px; color: #555; }
    .resume { max-width: 210mm; min-height: 297mm; margin: 0 auto; background: white; }
    .header { color: white; padding: 50px 60px; text-align: center; }
    .header h1 { font-size: 42px; font-weight: 300; letter-spacing: 2px; text-transform: uppercase; color: black; }
    .header .job-title { font-size: 16px; font-weight: 400; letter-spacing: 3px; text-transform: uppercase; }
    .content { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; padding: 50px 60px; }
    .section { margin-bottom: 35px; }
    .section-title {
      color: #c85a54; font-size: 14px; font-weight: 600; letter-spacing: 1.5px;
      text-transform: uppercase; margin-bottom: 20px; padding-bottom: 8px;
      border-bottom: 2px solid #c85a54;
    }
    .job, .education-item, .cert-item { margin-bottom: 25px; }
    .job-title { font-weight: 600; font-size: 15px; color: #333; margin-bottom: 3px; }
    .job-details { font-size: 13px; color: #666; margin-bottom: 10px; }
    ul { margin-left: 20px; margin-top: 8px; }
    li { font-size: 13px; line-height: 1.6; color: #555; margin-bottom: 8px; }
    .summary-text { font-size: 14px; line-height: 1.7; color: #555; text-align: justify; }
    .skills-list { list-style: none; margin-left: 0; }
    .skills-list li { padding-left: 20px; position: relative; margin-bottom: 10px; }
    .skills-list li:before { content: "•"; color: #c85a54; font-weight: bold; position: absolute; left: 0; }
  </style>
</head>

<body>
  <div class="resume">
    <!-- Header -->
    <div class="header">
      <h1>{{personal.firstName}} {{personal.lastName}}</h1>
      {{#if personal.title}}
        <div class="job-title">{{personal.title}}</div>
      {{/if}}
    </div>

    <!-- Main Content -->
    <div class="content">
      <!-- LEFT COLUMN -->
      <div class="left-column">

        <!-- Summary -->
        {{#if personal.summary}}
        <div class="section">
          <h2 class="section-title">Summary</h2>
          <p class="summary-text">{{personal.summary}}</p>
        </div>
        {{/if}}

        <!-- Education -->
        {{#if education.length}}
        <div class="section">
          <h2 class="section-title">Education</h2>
          {{#each education}}
          <div class="education-item">
            <div class="degree">{{degree}} in {{fieldOfStudy}}</div>
            <div class="school">{{school}} - {{location}}</div>
            {{#unless removeGraduationDate}}
            <div class="date">{{graduationMonth}} {{graduationYear}}</div>
            {{/unless}}
          </div>
          {{/each}}
        </div>
        {{/if}}

        <!-- Experience -->
        {{#if experience.length}}
        <div class="section">
          <h2 class="section-title">Work Experience</h2>
          {{#each experience}}
          <div class="job">
            <div class="job-header">
              <div class="job-title">{{position}}</div>
              <div class="job-details">
                <span class="date">{{startMonth}} {{startYear}} - 
                  {{#if isCurrentlyWorking}}Present{{else}}{{endMonth}} {{endYear}}{{/if}}
                </span> |
                <span class="company">{{company}}</span>,
                <span class="location">{{city}}, {{province}}, {{country}}</span>
              </div>
            </div>
            <ul>
              {{#each responsibilities}}
              <li>{{this}}</li>
              {{/each}}
            </ul>
          </div>
          {{/each}}
        </div>
        {{/if}}

      </div>

      <!-- RIGHT COLUMN -->
      <div class="right-column">

        <!-- Contact -->
        <div class="section">
          <h2 class="section-title">Contact</h2>
          {{#if personal.phone}}<div class="contact-item"> {{personal.phone}}</div>{{/if}}
          {{#if personal.email}}<div class="contact-item"> <a href="mailto:{{personal.email}}">{{personal.email}}</a></div>{{/if}}
          {{#if personal.city}}<div class="contact-item">{{personal.city}}, {{personal.state}}, {{personal.country}}</div>{{/if}}
          {{#if personal.linkedin}}<div class="contact-item"><a href="{{personal.linkedin}}">LinkedIn</a></div>{{/if}}
          {{#if personal.website}}<div class="contact-item"><a href="{{personal.website}}">{{personal.website}}</a></div>{{/if}}
        </div>

        <!-- Skills -->
        {{#if skills.length}}
        <div class="section">
          <h2 class="section-title">Skills</h2>
          <ul class="skills-list">
            {{#each skills}}
            <li>{{this}}</li>
            {{/each}}
          </ul>
        </div>
        {{/if}}

        <!-- Certifications -->
        {{#if certifications.length}}
        <div class="section">
          <h2 class="section-title">Certifications</h2>
          {{#each certifications}}
          <div class="cert-item">{{this}}</div>
          {{/each}}
        </div>
        {{/if}}

        <!-- References -->
        {{#if references.length}}
        <div class="section">
          <h2 class="section-title">References</h2>
          {{#each references}}
          <div class="reference-item">
            <div class="reference-name">{{firstName}} {{lastName}}</div>
            <div class="reference-title">{{jobTitle}}, {{company}}</div>
            <div class="reference-contact">Email: {{email}}</div>
            <div class="reference-contact">Phone: {{phone}}</div>
            <div class="reference-contact">{{relationshipStatus}}</div>
          </div>
          {{/each}}
        </div>
        {{else}}
        <div class="section">
          <h2 class="section-title">References</h2>
          <p>Available upon request.</p>
        </div>
        {{/if}}

      </div>
    </div>
  </div>
</body>
</html>
