<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{{resume.personal.firstName}} {{resume.personal.lastName}} - {{resume.personal.title}}</title>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Cambo&display=swap');
      body {
        display: flex;
        justify-content: center;
        width: 100%;
        font-size: 13pt;
      }
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: Cambo, Arial, sans-serif;
        font-size: 12pt;
      }
      a {
        color: #333;
      }
      li {
        list-style-position: inside;
        margin-bottom: 5px;
      }
      .resume-container {
        max-width: 210mm;
        width: 100%;
        page-break-inside: avoid;
      }
      .bold {
        font-weight: bold;
      }
      section {
        margin-bottom: 20px;
        page-break-inside: avoid;
      }
      .profile-container {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 8pt;
      }
      .profile-name {
        font-size: 30pt;
        font-weight: bold;
        color: rgb(3, 76, 158);
      }
      .social-link-container {
        border-top: 2pt solid #034c9e;
        border-bottom: 2pt solid #034c9e;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-evenly;
        padding: 10pt;
        gap: 4pt;
        align-items: center;
      }
      .summary {
        line-height: 16pt;
        text-align: justify;
        font-style: italic;
      }
      .section-header {
        display: flex;
        flex-direction: column;
        gap: 10px;
      }
      .section-title {
        color: #034c9e;
        font-weight: 700;
      }
      .ruler {
        height: 3px;
        width: 100%;
        background-color: #034c9e;
      }
      .experience-header,
      .education-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin: 10px 0;
      }
      .skill-container {
        margin: 8px 0;
      }
      .company {
        font-weight: 700;
      }
      .title {
        font-style: italic;
      }
      .location {
        font-weight: 700;
      }
      .duties {
        margin-left: 30px;
      }
    </style>
  </head>
  <body>
    <div class="resume-container">
      <!-- Header -->
      <section class="header">
        <div class="profile-container">
          <h2 class="profile-name">{{resume.personal.firstName}} {{resume.personal.lastName}}</h2>
          <p>{{resume.personal.title}}</p>
        </div>
      </section>

      <!-- Contact -->
      <section>
        <div class="social-link-container">
          <p>{{resume.personal.phone}}</p>
          <p>{{resume.personal.email}}</p>
          <p>{{resume.personal.city}}, {{personal.state}}, {{personal.country}}</p>
          <p>{{resume.personal.postalCode}}</p>
        </div>
      </section>
      <!-- Summary -->
      <section>
        <p class="summary">{{resume.personal.summary}}</p>
      </section>

      <!-- Experience -->
      <section id="experience">
        <div class="section-header">
          <h2 class="section-title">PROFESSIONAL EXPERIENCE</h2>
          <div class="ruler"></div>
        </div>

        {{#each resume.experience}}
        <div class="experience-container">
          <div class="experience-header">
            <div>
              <h3 class="company">{{company}}</h3>
              <p class="title">{{position}}</p>
            </div>
            <div style="text-align: right">
              <p class="location">{{city}}, {{province}}, {{country}}</p>
              <p class="title">{{startMonth}} {{startYear}} - {{#if isCurrentlyWorking}}Present{{else}}{{endMonth}} {{endYear}}{{/if}}</p>
            </div>
          </div>
          <div class="duties">
            <ul>
              {{#each responsibilities}}
                <li>{{this}}</li>
              {{/each}}
            </ul>
          </div>
        </div>
        {{/each}}
      </section>

      <!-- Education -->
      <section id="education">
        <div class="section-header">
          <h2 class="section-title">EDUCATION</h2>
          <div class="ruler"></div>
        </div>

        {{#each resume.education}}
        <div class="education-container">
          <div>
            <h3 class="company">{{degree}} in {{fieldOfStudy}}</h3>
            <p>{{school}}, <span class="bold">{{location}}</span></p>
          </div>
          {{#unless removeGraduationDate}}
          <p style="text-align: right" class="title">{{graduationMonth}} {{graduationYear}}</p>
          {{/unless}}
        </div>
        {{/each}}
      </section>

      <!-- Skills -->
      <section id="skills">
        <div class="section-header">
          <h2 class="section-title">SKILLS</h2>
          <div class="ruler"></div>
        </div>
        <div class="skill-container">
          <ul>
            {{#each resume.skills}}
              <li>{{this}}</li>
            {{/each}}
          </ul>
        </div>
      </section>

      <!-- Certifications -->
      <section id="certification">
        <div class="section-header">
          <h2 class="section-title">CERTIFICATIONS</h2>
          <div class="ruler"></div>
        </div>
        <div class="skill-container">
          <ul>
            {{#each resume.certifications}}
              <li>{{this}}</li>
            {{/each}}
          </ul>
        </div>
      </section>

      <!-- References -->
      <section id="references">
        <div class="section-header">
          <h2 class="section-title">REFERENCES</h2>
          <div class="ruler"></div>
        </div>
        <div class="skill-container">
          <ul>
            {{#if resume.references}}
              {{#each references}}
                <li>{{firstName}} {{lastName}} - {{jobTitle}}, {{company}}. Email: {{email}}, Phone: {{phone}} ({{relationshipStatus}})</li>
              {{/each}}
            {{else}}
              <li>Available upon request</li>
            {{/if}}
          </ul>
        </div>
      </section>
    </div>
  </body>
</html>
