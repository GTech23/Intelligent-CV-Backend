<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
      <%= resume.personal.firstName %> <%= resume.personal.lastName %> | <%=
      resume.personal.title %>
    </title>

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bree+Serif&display=swap"
      rel="stylesheet"
    />
    <style>
      body {
        font-family: "Bree Serif", sans-serif;
        margin: 0;
        padding: 40px;
        color: var(--text-dark);
        background-color: #ffffff;
        font-size: 14px;
        line-height: 1.5;
      }

      .resume-container {
        max-width: 210mm;
        min-height: 297mm;
        margin: 0 auto;
      }

      :root {
        --primary-blue: #c4881c;
        --text-dark: #19273c;
        --text-medium: #555;
        --bg-light: #f7f7f7;
        --line-gray: #ddd;
      }

      .header {
        margin-bottom: 25px;
        padding-bottom: 5px;
        border-bottom: 1px solid var(--line-gray);
      }

      .header h1 {
        font-size: 32px;
        font-weight: 700;
        color: var(--text-dark);
        margin: 0 0 5px 0;
        text-transform: uppercase;
      }

      .header h2 {
        font-size: 16px;
        font-weight: 500;
        color: var(--primary-blue);
        margin: 0 0 10px 0;
      }

      .contact-row {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        font-size: 13px;
        color: var(--text-medium);
        line-height: 1.8;
      }

      .contact-row span {
        margin-right: 15px;
        display: flex;
        align-items: center;
      }

      .contact-row svg {
        margin-right: 4px;
      }

      .contact-row a {
        color: var(--text-medium);
        text-decoration: none;
      }

      .section-title {
        font-size: 18px;
        font-weight: 700;
        color: var(--text-dark);
        margin: 30px 0 15px 0;
        padding-bottom: 5px;
        border-bottom: 2px solid var(--primary-blue);
        display: inline-block;
        text-transform: uppercase;
      }

      .summary p {
        margin: 0;
        color: var(--text-medium);
        font-size: 14px;
      }

      /* --- References Section Styling --- */
      .references p {
        margin: 0;
        color: var(--text-medium);
        font-style: italic;
      }

      .timeline {
        margin-top: 15px;
      }

      .timeline-item {
        display: flex;
        margin-bottom: 25px;
      }

      .timeline-left {
        width: 180px;
        padding-right: 15px;
        font-size: 13px;
        line-height: 1.3;
        color: var(--text-medium);
        text-align: right;
        position: relative;
      }

      .timeline-right {
        flex-grow: 1;
        padding-left: 25px;
        border-left: 2px solid var(--line-gray);
        position: relative;
        padding-top: 3px;
      }

      .timeline-right::before {
        content: "";
        position: absolute;
        left: -8px;
        top: 0;
        width: 12px;
        height: 12px;
        background: var(--primary-blue);
        border-radius: 50%;
        border: 3px solid #fff;
        box-shadow: 0 0 0 1px var(--primary-blue);
        box-sizing: border-box;
      }

      .item-title {
        font-size: 16px;
        font-weight: 500;
        color: var(--text-dark);
        margin: 0 0 2px 0;
        line-height: 1.2;
      }

      .item-subtitle {
        font-size: 14px;
        font-weight: 500;
        color: var(--primary-blue);
        margin: 0 0 8px 0;
      }

      .item-description ul {
        list-style: disc;
        padding-left: 20px;
        margin: 0;
        color: var(--text-medium);
      }

      .item-description li {
        margin-bottom: 5px;
        font-size: 13px;
      }

      .education-item .timeline-right {
        padding-top: 0;
      }

      .education-item .timeline-right::before {
        top: 3px;
      }

      /* --- Certifications Section (mapped from Achievements design) --- */
      .certifications-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-top: 15px;
      }

      .certification-item {
        padding-right: 15px;
      }

      .certification-item p {
        font-size: 13px;
        color: var(--text-medium);
        margin: 5px 0 0 0;
        line-height: 1.4;
      }

      .certification-icon {
        color: var(--primary-blue);
        margin-right: 5px;
      }

      .certification-header {
        font-weight: 500;
        color: var(--text-dark);
        display: flex;
        align-items: center;
      }

      /* --- Skills Section --- */
      .skills-list {
        margin-top: 15px;
      }

      .skill-pill {
        display: inline-block;
        background-color: var(--bg-light);
        color: var(--text-dark);
        padding: 5px 12px;
        margin-right: 10px;
        margin-bottom: 10px;
        border-radius: 4px;
        font-weight: 500;
        font-size: 13px;
      }

      /* --- Footer (Removed Enhancv promotion, simplified) --- */
      .footer {
        margin-top: 50px;
        padding-top: 10px;
        border-top: 1px solid var(--line-gray);
        display: flex;
        justify-content: center;
        font-size: 12px;
        color: #999;
      }
    </style>
  </head>
  <body>
    <div class="resume-container">
      <div class="header">
        <h1>
          <%= resume.personal.firstName %> <%= resume.personal.lastName %>
        </h1>
        <h2><%= resume.personal.title %></h2>
        <div class="contact-row">
          <span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
            >
              <path
                fill="currentColor"
                d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 0 1 0-5 2.5 2.5 0 0 1 0 5z"
              />
            </svg>
            <%= resume.personal.city %>, <%= resume.personal.country %>
          </span>

          <span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
            >
              <path
                fill="currentColor"
                d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.18C16.6 15.48 18.25 16 20 16c.55 0 1 .45 1 1v3c0 .55-.45 1-1 1C10.83 21 3 13.17 3 4c0-.55.45-1 1-1h3c.55 0 1 .45 1 1 0 1.75.52 3.4.16 4.87-.18.35-.09.75.18 1.02l2.2 2.2z"
              />
            </svg>
            <%= resume.personal.phone %>
          </span>

          <span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
            >
              <path
                fill="currentColor"
                d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"
              />
            </svg>
            <a href="mailto:<%= resume.personal.email %>"
              ><%= resume.personal.email %></a
            >
          </span>
        </div>
      </div>

      <div class="summary section">
        <h3 class="section-title">SUMMARY</h3>
        <p><%= resume.personal.summary %></p>
      </div>

      <% if (resume.experience.length > 0) { %>
      <div class="experience section">
        <h3 class="section-title">EXPERIENCE</h3>
        <div class="timeline">
          <% resume.experience.forEach(exp => { %>
          <div class="timeline-item">
            <div class="timeline-left">
              <p>
                <%= exp.startMonth %> <%= exp.startYear %> - <%=
                exp.isCurrentlyWorking ? 'Present' : exp.endMonth + ' ' +
                exp.endYear %>
              </p>
              <p><%= exp.city, exp.province, exp.country %></p>
            </div>
            <div class="timeline-right">
              <p class="item-title"><%= exp.title %></p>
              <p class="item-subtitle"><%= exp.company %></p>
              <div class="item-description">
                <ul>
                  <% exp.responsibilities.forEach(resp => { %>
                  <li><%= resp %></li>
                  <% }); %>
                </ul>
              </div>
            </div>
          </div>
          <% }); %>
        </div>
      </div>
      <% } %>

      <div class="education section">
        <h3 class="section-title">EDUCATION</h3>
        <div class="timeline">
          <% resume.education.forEach(edu => { %>
          <div class="timeline-item education-item">
            <div class="timeline-left">
              <p><%= edu.graduationMonth %> <%= edu.graduationYear %></p>
              <p><%= edu.location %></p>
            </div>
            <div class="timeline-right">
              <p class="item-title">
                <%= edu.degree %> in <%= edu.fieldOfStudy %>
              </p>
              <p class="item-subtitle"><%= edu.school %></p>
            </div>
          </div>
          <% }); %>
        </div>
      </div>

      <% if (resume.certifications.length > 0) { %>
      <div class="certifications section">
        <h3 class="section-title">CERTIFICATIONS</h3>
        <div class="certifications-grid">
          <% resume.certifications.forEach((cert, index) => { %>
          <div class="certification-item">
            <p class="certification-header">
              <span class="certification-icon">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                >
                  <path
                    fill="currentColor"
                    d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z"
                  />
                </svg>
              </span>
              <%= cert %>
            </p>
          </div>
          <% }); %>
        </div>
      </div>
      <% } %>

      <div class="skills section">
        <h3 class="section-title">SKILLS</h3>
        <div class="skills-list">
          <% resume.skills.forEach(skill => { %>
          <span class="skill-pill"><%= skill %></span>
          <% }); %>
        </div>
      </div>

      <% if (resume.references) { %>
      <div class="references section">
        <h3 class="section-title">REFERENCES</h3>
        <% if (Array.isArray(resume.references) && resume.references.length > 0)
        { %>
        <div class="references-list">
          <% resume.references.forEach(ref => { %>
          <p><%= ref.firstName %> <%= ref.lastName %></p>
          <p>
            <%= ref.jobTitle ? ref.jobTitle + ' - ' + ref.company : ref.company
            %>
          </p>
          <p><%= ref.phone %></p>
          <p><%= ref.email %></p>

          <% }); %>
        </div>
        <% } else { %>
        <p>References available upon request.</p>
        <% } %>
      </div>
      <% } %>
    </div>
  </body>
</html>
