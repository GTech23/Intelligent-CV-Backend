<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Professional Resume</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet" />
  <style>
    @page {
      size: A4;
      margin: 20mm;
    }

    body {
      font-family: 'Poppins', sans-serif;
      background: #f5f7fa;
      color: #222;
      display: flex;
      justify-content: center;
      align-items: flex-start;
      margin: 0;
      padding: 0;
    }

    .resume {
      background: #fff;
      width: 210mm;
      min-height: 297mm;
      display: grid;
      grid-template-columns: 35% 65%;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
      border-radius: 8px;
      overflow: hidden;
    }

    .left-panel {
      background: #1e3a8a;
      color: #fff;
      padding: 30px 25px;
      display: flex;
      flex-direction: column;
    }

    .right-panel {
      padding: 30px 40px;
    }

    .profile-pic {
      width: 120px;
      height: 120px;
      border-radius: 50%;
      background: #fff;
      margin: 0 auto 20px;
      overflow: hidden;
    }

    .profile-pic img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .name {
      text-align: center;
      font-size: 24px;
      font-weight: 700;
      margin-top: 10px;
    }

    .role {
      text-align: center;
      font-size: 14px;
      font-weight: 400;
      color: #d1d5db;
      margin-bottom: 25px;
    }

    .left-section {
      margin-bottom: 30px;
    }

    .left-section h3 {
      text-transform: uppercase;
      font-size: 14px;
      letter-spacing: 1px;
      margin-bottom: 10px;
      color: #bfdbfe;
    }

    .left-section p,
    .left-section li {
      font-size: 13px;
      line-height: 1.6;
      margin: 4px 0;
    }

    .left-section ul {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .right-panel section {
      margin-bottom: 30px;
    }

    .right-panel h2 {
      color: #1e3a8a;
      border-bottom: 2px solid #1e3a8a;
      font-size: 18px;
      padding-bottom: 4px;
      margin-bottom: 12px;
      text-transform: uppercase;
    }

    .right-panel p,
    .right-panel li {
      font-size: 14px;
      color: #333;
      line-height: 1.7;
    }

    .right-panel ul {
      list-style: disc;
      margin-left: 20px;
    }

    .job {
      margin-bottom: 20px;
    }

    .job h4 {
      margin: 0;
      font-size: 16px;
      font-weight: 600;
      color: #1e3a8a;
    }

    .job span {
      font-size: 13px;
      color: #555;
    }

    .responsibilities {
      margin-top: 6px;
    }

    .responsibilities li {
      margin-bottom: 5px;
    }

    .reference-item {
      margin-bottom: 12px;
    }

    .reference-item span {
      display: block;
      font-size: 13px;
      color: #555;
    }
  </style>
</head>
<body>
  <div class="resume">
    <!-- LEFT PANEL -->
    <aside class="left-panel">
      <div class="profile-pic">
        <img src="profile.jpg" alt="Profile Photo">
      </div>
      <div class="name">John Doe</div>
      <div class="role">Software Engineer</div>

      <!-- Contact -->
      <div class="left-section">
        <h3>Contact</h3>
        <p>Email: johndoe@example.com</p>
        <p>Phone: +1 234 567 890</p>
        <p>LinkedIn: linkedin.com/in/johndoe</p>
        <p>Address: 123 Main Street, City, Country</p>
      </div>

      <!-- Skills -->
      <div class="left-section">
        <h3>Skills</h3>
        <ul>
          <li>JavaScript / React / Node.js</li>
          <li>MongoDB / Firebase / SQL</li>
          <li>HTML / CSS / Tailwind</li>
          <li>Git / CI-CD / Docker</li>
        </ul>
      </div>

      <!-- Certifications -->
      <div class="left-section">
        <h3>Certifications</h3>
        <ul>
          <li>Google Cloud Developer</li>
          <li>Meta Front-End Developer</li>
          <li>FreeCodeCamp Full Stack</li>
        </ul>
      </div>
    </aside>

    <!-- RIGHT PANEL -->
    <main class="right-panel">
      <!-- Summary -->
      <section class="summary">
        <h2>Professional Summary</h2>
        <p>Experienced software engineer with a strong background in full-stack development. Adept at delivering robust, scalable, and user-friendly applications. Skilled in collaborating across teams and ensuring on-time project delivery using agile methodologies.</p>
      </section>

      <!-- Work Experience -->
      <section class="experience">
        <h2>Work Experience</h2>

        <div class="job">
          <h4>Senior Software Engineer — ABC Tech Solutions</h4>
          <span>Jan 2021 – Present</span>
          <ul class="responsibilities">
            <li>Led a team of 5 developers in building enterprise web platforms.</li>
            <li>Implemented RESTful APIs and optimized database performance.</li>
            <li>Enhanced UX through modern, responsive interfaces.</li>
          </ul>
        </div>

        <div class="job">
          <h4>Frontend Developer — XYZ Digital Agency</h4>
          <span>Jun 2018 – Dec 2020</span>
          <ul class="responsibilities">
            <li>Developed responsive UI components using React and Tailwind CSS.</li>
            <li>Collaborated with backend engineers for seamless integration.</li>
            <li>Ensured accessibility compliance and mobile optimization.</li>
          </ul>
        </div>

        <div class="job">
          <h4>Web Developer — BrightCode Solutions</h4>
          <span>Mar 2016 – May 2018</span>
          <ul class="responsibilities">
            <li>Designed and developed client websites using HTML, CSS, and JavaScript.</li>
            <li>Integrated CMS tools and handled client maintenance support.</li>
            <li>Improved SEO rankings through optimized markup.</li>
          </ul>
        </div>

        <div class="job">
          <h4>Junior Developer — NovaSoft Innovations</h4>
          <span>Jan 2014 – Feb 2016</span>
          <ul class="responsibilities">
            <li>Supported senior developers in maintaining internal web systems.</li>
            <li>Assisted with database management and data visualization.</li>
            <li>Participated in quality assurance and testing.</li>
          </ul>
        </div>

        <div class="job">
          <h4>Intern — VisionTech Labs</h4>
          <span>Jun 2013 – Dec 2013</span>
          <ul class="responsibilities">
            <li>Contributed to small feature enhancements and bug fixes.</li>
            <li>Worked closely with QA to improve software reliability.</li>
            <li>Documented workflows and code updates for team use.</li>
          </ul>
        </div>
      </section>

      <!-- References -->
      <section class="references">
        <h2>References</h2>
        <div class="reference-item">
          <strong>Jane Smith</strong> — Tech Lead, ABC Corp.
          <span>Email: jane.smith@abccorp.com</span>
        </div>
        <div class="reference-item">
          <strong>Michael Brown</strong> — Project Manager, XYZ Ltd.
          <span>Email: michael.brown@xyz.com</span>
        </div>
      </section>
    </main>
  </div>
</body>
</html>
